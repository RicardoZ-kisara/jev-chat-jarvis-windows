{
  "name": "jev-chat-windows",
  "version": "0.1.0",
  "description": "QQ-only Windows chat copilot with local OCR and human-controlled replies",
  "author": "RicardoZ-kisara; original project: jev-chat contributors",
  "license": "MIT",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "prepare:ocr": "node scripts/prepare-ocr.cjs",
    "test": "node --test test/*.test.cjs",
    "test:desktop": "node scripts/desktop-smoke.cjs",
    "dist": "npm run prepare:ocr && electron-builder --win nsis portable --x64 --publish never"
  },
  "dependencies": {
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "playwright": "1.63.0"
  },
  "build": {
    "appId": "io.github.ricardoz-kisara.jev-chat-windows",
    "productName": "Jev QQ Windows",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "native/**/*",
      "resources/icon.ico",
      "package.json",
      "LICENSE",
      "THIRD_PARTY.md"
    ],
    "extraResources": [
      {
        "from": "resources/ocr",
        "to": "ocr"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "resources/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Jev-QQ-Windows-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Jev-QQ-Windows-Portable-${version}-${arch}.${ext}"
    }
  }
}
